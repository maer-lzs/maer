<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay-Audio: Apples Freigabe fuer die App-ID wurde am 26.07.2026
	     erteilt — seitdem gilt EINE Entitlements-Datei fuer Simulator UND
	     Geraet. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Geteilter Container fuer das Home-Screen-Widget (Snapshot + Cover).
	     Forks: an eigene Bundle-Struktur anpassen (auch in
	     WidgetShared.swift und MaerWidgets.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fm.maer.app</string>
	</array>
	<!-- iCloud Key-Value-Storage fuer den geraeteuebergreifenden Sync
	     (Podcast-Fortschritt, Playlists, Wahlen, Hoerstatistik, Claim;
	     NSUbiquitousKeyValueStore). Jeder Bestand hat lokale Wahrheit und
	     veroeffentlicht sich beim ersten Abgleich in einen leeren Topf
	     selbst. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fm.maer.app</string>
	<!-- iCloud/CloudKit-Container. Aktuell NICHT vom Code genutzt (der
	     Sync laeuft ueber KVS oben); registriert fuer kuenftige
	     CloudKit-Daten. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.fm.maer.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
