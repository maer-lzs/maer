<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio. The app ID carries Apple's grant, so one file serves
	     the simulator and the device. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Shared container for the home screen widget (snapshot and cover).
	     Forks: match it to their own bundle structure (also in
	     WidgetShared.swift and MaerWidgets.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fm.maer.app</string>
	</array>
	<!-- iCloud key-value storage for the sync across devices (podcast
	     progress, playlists, choices, listening statistics, claim;
	     NSUbiquitousKeyValueStore). Every store keeps its local truth and
	     publishes itself into an empty pot at its first sync. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fm.maer.app</string>
	<!-- iCloud and CloudKit container. The code does not use it; the sync
	     runs over the key-value storage above. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.fm.maer.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes of the stand zone speed up the sync in the
	     foreground; they do not carry it, because Apple throttles silent
	     pushes on a locked device. The poll every ten seconds while playing
	     carries it. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: a link on maer.fm under /l opens the shared
	     episode, show, station or audiobook in the app. The domain answers
	     with site/.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:maer.fm</string>
	</array>
</dict>
</plist>
