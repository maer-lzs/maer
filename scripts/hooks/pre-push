#!/bin/bash
# Mär — an audio player for self-hosted open ecosystems
# Copyright (C) 2026 Laurenz Schröder
# SPDX-License-Identifier: GPL-3.0-or-later
# Additional terms apply — see LICENSE-ADDITIONAL-TERMS
#
# pre-push: every push goes through scripts/lauf.sh push or release. Refused
# always: another remote than origin, a deletion, and anything that is no fast
# forward (force, force with lease, rewritten history). The one deletion is
# lauf.sh aufraeumen (LAUF_AUFRAEUMEN): a branch that dev holds whole, never
# dev, main, a tag or the notes. A tag and main only
# through lauf.sh release (LAUF_RELEASE, the tag it pushes): the tag new, main
# only to the commit of that tag. dev, main and a tag need the note of the
# final run at the commit, unless the commit is from before the script. Every
# commit new to the server keeps the rules of the commit message (rules.py).
# A branch keeps the order of R8, rule 10 of the coding rules (lauf.sh r8): a red test commit before the
# first change of Sources/, unless its name says form-, nachzug- or sprache-.
# The script is known by LAUF_PUSH and LAUF_RELEASE; both can be set by hand
# (named limit).
set -u
HOOKS="$(cd "$(dirname "$0")" && pwd)"
release="${LAUF_RELEASE:-}"
remote_name="$1"
zero=0000000000000000000000000000000000000000
refuse() { echo "pre-push: $*" >&2; exit 1; }

[ "${LAUF_PUSH:-}" = 1 ] || refuse "Push nur ueber scripts/lauf.sh push <zweig|dev|nachzug|doku>"
[ "$remote_name" = origin ] || refuse "nur nach origin, nicht nach $remote_name"

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    [ -n "${LAUF_HOOK_LOG:-}" ] && echo "$local_ref $local_sha $remote_ref" >> "$LAUF_HOOK_LOG"
    if [ "$local_sha" = "$zero" ]; then
        # The one deletion: lauf.sh aufraeumen, a branch the server's dev
        # holds whole, never dev, main, a tag or the notes.
        [ "${LAUF_AUFRAEUMEN:-}" = 1 ] || refuse "kein Loeschen: $remote_ref"
        case "$remote_ref" in
            refs/heads/dev|refs/heads/main) refuse "kein Loeschen: $remote_ref";;
            refs/heads/*) ;;
            *) refuse "kein Loeschen: $remote_ref";;
        esac
        git cat-file -e "$remote_sha" 2>/dev/null && git merge-base --is-ancestor "$remote_sha" refs/remotes/origin/dev \
            || refuse "kein Loeschen: ${remote_ref#refs/heads/} haelt Commits, die dev nicht haelt"
        continue
    fi
    noted=""
    case "$remote_ref" in
        refs/tags/*)
            [ -n "$release" ] && [ "$remote_ref" = "refs/tags/$release" ] || refuse "ein Tag nur ueber lauf.sh release: $remote_ref"
            [ "$remote_sha" = "$zero" ] || refuse "ein Tag wird nicht verschoben: $remote_ref"
            noted="$(git rev-parse "$local_sha^{commit}")";;
        refs/heads/main)
            [ -n "$release" ] || refuse "main nur ueber lauf.sh release"
            [ "$local_sha" = "$(git rev-parse -q --verify "refs/tags/$release^{commit}")" ] || refuse "main nur auf den Commit von $release"
            noted="$local_sha";;
        refs/heads/dev) noted="$local_sha";;
        refs/heads/*)
            why="$(bash "$HOOKS/../lauf.sh" r8 "${remote_ref#refs/heads/}" "$local_sha" 2>&1)" || refuse "R8: $why";;
    esac
    if [ "$remote_sha" != "$zero" ]; then
        git cat-file -e "$remote_sha" 2>/dev/null && git merge-base --is-ancestor "$remote_sha" "$local_sha" \
            || refuse "kein Vorspulen auf $remote_ref: Geschichte wird nicht umgeschrieben"
    fi
    [ "$remote_ref" = refs/notes/lauf ] && continue
    if [ -n "$noted" ] && ! bash "$HOOKS/../lauf.sh" vor-dem-skript "$noted" >/dev/null 2>&1; then
        tree="$(git rev-parse "$noted^{tree}")"
        git notes --ref=lauf show "$noted" 2>/dev/null | grep "art=abschluss" | grep "laufzeiten=27,18.6" | grep "ergebnis=gruen" | grep -q "baum=$tree" \
            || refuse "${remote_ref#refs/heads/} verlangt den Vermerk des vollen Laufs auf 27 und 18.6 an $(git rev-parse --short "$noted")"
    fi
    # Only commits new to the server: main and a tag point at commits that
    # are on dev already.
    range=("$local_sha" --not --remotes=origin)
    [ "$remote_sha" = "$zero" ] || range+=("^$remote_sha")
    for commit in $(git rev-list "${range[@]}"); do
        message="$(mktemp)"
        git log -1 --format=%B "$commit" > "$message"
        why="$(python3 -I "$HOOKS/rules.py" msg "$message" 2>&1)"; rc=$?
        rm -f "$message"
        [ $rc -eq 0 ] || refuse "Commit $(git rev-parse --short "$commit") bricht die Regeln der Meldung: $why"
    done
    # The ref still points where git measured it: a commit during the push
    # moves the ref, and the server would get another commit than this one.
    now="$(git rev-parse -q --verify "$local_ref" 2>/dev/null)"
    [ -z "$now" ] || [ "$now" = "$local_sha" ] || refuse "$local_ref ist gewandert: geprueft $(git rev-parse --short "$local_sha"), jetzt $(git rev-parse --short "$now")"
done
exit 0
