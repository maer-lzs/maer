<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay-Audio: Apples Freigabe fuer die App-ID wurde am 26.07.2026
	     erteilt — seitdem gilt EINE Entitlements-Datei fuer Simulator UND
	     Geraet (die fruehere Simulator-Sonderdatei ABSPlayer-CarPlay
	     .entitlements ist entfernt; Historie siehe git). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Geteilter Container fuer das Home-Screen-Widget (Snapshot + Cover)
	     UND die Bruecken-Faehre des ID-Umzugs: die ALTE Gruppe bleibt mit
	     Absicht, alte und neue App teilen sie (v2.8.x exportiert hierher,
	     die neue App importiert). Forks: an eigene Bundle-Struktur anpassen
	     (auch in WidgetShared.swift und MaerWidgets.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.lzs.ABSPlayer</string>
	</array>
	<!-- iCloud Key-Value-Storage fuer den geraeteuebergreifenden Podcast-
	     Fortschritt (PodcastCloudSync, NSUbiquitousKeyValueStore).
	     GEPINNT auf die ALTE Kennung (Entscheid zum ID-Umzug): abgeleitet
	     aus $(CFBundleIdentifier) haette der Flip auf fm.maer.app den
	     aktiven Sync-Topf gewechselt und jeden Fortschritt der Alt-App
	     zurueckgelassen. Alte und neue App lesen DENSELBEN Topf. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)de.lzs.ABSPlayer</string>
	<!-- iCloud/CloudKit-Container. Aktuell NICHT vom Code genutzt (der Sync
	     laeuft ueber KVS oben). Die ALTE Container-Kennung bleibt mit
	     Absicht (Pin-Entscheid des ID-Umzugs): Container-IDs sind vom
	     Bundle unabhaengig benannt, und ein Wechsel haette kuenftige
	     CloudKit-Daten vom Alt-Bestand getrennt. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.lzs.ABSPlayer</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
