<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay-Audio: Apples Freigabe fuer die App-ID wurde am 26.07.2026
	     erteilt — seitdem gilt EINE Entitlements-Datei fuer Simulator UND
	     Geraet (die fruehere Simulator-Sonderdatei ABSPlayer-CarPlay
	     .entitlements ist entfernt; Historie siehe git). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Geteilter Container fuer das Home-Screen-Widget (Snapshot + Cover).
	     Forks: an eigene Bundle-Struktur anpassen (auch in WidgetShared.swift
	     und MaerWidgets.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.lzs.ABSPlayer</string>
	</array>
	<!-- iCloud Key-Value-Storage fuer den geraeteuebergreifenden Podcast-
	     Fortschritt (PodcastCloudSync, NSUbiquitousKeyValueStore). Bei
	     automatischem Signing aktiviert Xcode die iCloud-Capability der
	     App-ID daraufhin selbst. UNVERAENDERT lassen — der aktive Sync. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- iCloud/CloudKit-Container. Aktuell NICHT vom Code genutzt (der Sync
	     laeuft ueber KVS oben); provisioniert fuer kuenftige CloudKit-Nutzung
	     und damit die iCloud-Capability der App-ID vollstaendig eingerichtet
	     ist. Bei automatischem Signing legt Xcode den Container im (bezahlten)
	     Dev-Account an. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.lzs.ABSPlayer</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
