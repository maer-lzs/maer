<title>Synthetic Podcast Subscriptions</title>
</head>
<body>
<outline text="True Crime" title="True Crime">
<outline text="Serial Stories" xmlUrl="https://example.com/serial.xml"/>
<outline text="Cold Case Files" xmlUrl="https://example.com/coldcase.xml"/>
</outline>
</body>
</opml>
