    },
    "Their listening positions go, on this device and on your other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Hörstände gehen, auf diesem Gerät und auf deinen anderen Geräten."
          }
