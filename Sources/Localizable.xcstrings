{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "“%@” looks like the premium version of an existing subscription. Replace the free feed and carry over listening progress and downloads?" : {
      "comment" : "A confirmation dialog asking whether to replace a free podcast subscription with a premium one.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sieht aus wie die Premium-Version eines bestehenden Abos. Den freien Feed ersetzen und Hörfortschritt sowie Downloads übernehmen?"
          }
        }
      }
    },
    "%@" : {
      "comment" : "Buch-Titel",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "%@ · %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@"
          }
        }
      }
    },
    "%@ · album ends %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Album endet %@"
          }
        }
      }
    },
    "%@ could not be downloaded: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ließ sich nicht laden: %@"
          }
        }
      }
    },
    "%@ could not be indexed. It will be tried again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht indiziert werden. Es wird erneut versucht."
          }
        }
      }
    },
    "%@ exists as a free AND a premium subscription." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist frei UND als Premium abonniert."
          }
        }
      }
    },
    "%@ has no library yet. That tab stays off until you pick one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Bibliothek. Dieser Tab bleibt aus, bis du eine wählst."
          }
        }
      }
    },
    "%@ in chapter · book ends %@" : {
      "localizations" : {
