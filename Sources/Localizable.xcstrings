    },
    "The subscription guard blocked an implausible mass removal. This warning stays until the next clean sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abo-Schutz hat eine unplausible Massenlöschung blockiert. Diese Warnung bleibt bis zum nächsten sauberen Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección de suscripciones ha bloqueado una eliminación masiva poco plausible. Este aviso se mantiene hasta la próxima sincronización correcta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protection des abonnements a bloqué une suppression massive invraisemblable. Cet avertissement reste jusqu’à la prochaine synchronisation sans erreur."
