    "Premium feeds carry access data in their address. Off keeps them on this device only; mirrors stay out either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium-Feeds tragen Zugangsdaten in ihrer Adresse. Aus heißt: sie bleiben nur auf diesem Gerät; Spiegel bleiben ohnehin außen vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los feeds premium llevan datos de acceso en su dirección. Desactivado los mantiene solo en este dispositivo; las réplicas quedan fuera en cualquier caso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
