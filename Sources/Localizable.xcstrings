    "“%@” already has a rule for this show. Remove it first to choose another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat schon eine Regel für diese Sendung. Entferne sie zuerst, um eine andere zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» ya tiene una regla para este programa. Elimínala primero para elegir otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a déjà une règle pour cette émission. Retirez-la d’abord pour en choisir une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» ha già una regola per questo programma. Rimuovila prima di sceglierne un'altra."
          }
        }
      }
    },
    "“%@” looks like the premium version of an existing subscription. Replace the free feed and carry over listening progress and downloads?" : {
      "comment" : "A confirmation dialog asking whether to replace a free podcast subscription with a premium one.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sieht aus wie die Premium-Version eines bestehenden Abos. Den freien Feed ersetzen und Hörfortschritt sowie Downloads übernehmen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» parece la versión premium de una suscripción existente. ¿Sustituir el feed gratuito y conservar el progreso de escucha y las descargas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » semble être la version premium d’un abonnement existant. Remplacer le flux gratuit et reprendre la progression d’écoute et les téléchargements ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» sembra la versione premium di un'iscrizione esistente. Vuoi sostituire il feed gratuito e trasferire i progressi di ascolto e i download?"
          }
        }
      }
    },
