      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weltweit"
          }
        }
      }
    },
    "Wrong username or password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falscher Benutzername oder falsches Passwort."
          }
        }
      }
    },
    "Yes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja"
          }
        }
      }
    },
    "Yes, that was me" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja, das war ich"
          }
        }
      }
    },
    "You're not on Wi-Fi. This download may use cellular data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist aktuell nicht im WLAN. Der Download könnte dein Mobilfunk-Datenvolumen verbrauchen."
          }
        }
      }
    },
    "Your Audiobookshelf account credentials. On servers with the new token system, playback may sign out when the token expires. Use an API key there instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Audiobookshelf-Zugangsdaten. Auf Servern mit dem neuen Token-System kann die Sitzung ablaufen. Dort besser einen API-Key verwenden."
          }
        }
      }
    },
    "Your email and password go to Pocket Casts only and are not stored; nothing runs in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mail und Passwort gehen nur an Pocket Casts und werden nicht gespeichert; nichts läuft im Hintergrund."
          }
        }
      }
    },
    "Your episodes and listening positions stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Folgen und Hörstände bleiben."
          }
        }
      }
    },
    "Your feeds classified as free. Pick one whose premium access the automatic detection missed. Paid feeds usually come as a personal podcatcher URL you copy from your provider's account page and add per show." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine frei eingestuften Abos. Wähle einen Feed, dessen Premium-Zugang die automatische Erkennung nicht erkannt hat. Bezahlte Feeds bekommst du meist als persönliche Podcatcher-URL, die du im Konto beim Anbieter kopierst und je Show hinzufügst."
          }
        }
      }
    },
    "Your library is empty. Add audiobooks via the Audiobookshelf web interface." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bibliothek ist leer. Füge Hörbücher über die Audiobookshelf-Weboberfläche hinzu."
          }
        }
      }
    },
    "Your Mär sync service is set up, but nothing travels over it now. Its page says why." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mär-Sync-Dienst ist eingerichtet, aber gerade reist nichts über ihn. Seine Seite sagt, warum."
          }
        }
      }
    },
    "Your own audiobook server. Files on this device work without any server. Connecting to a server on your home network may ask for local-network permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Hörbuch-Server. Dateien auf diesem Gerät funktionieren ganz ohne Server. Beim Verbinden mit einem Server im Heimnetz fragt iOS nach der Berechtigung fürs lokale Netzwerk."
          }
        }
      }
    },
    "Your own holdings, always shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Bestand, immer sichtbar."
          }
        }
      }
    },
    "your own subscriptions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deine eigenen Abos"
          }
        }
      }
    },
    "Your own sync service: keeps progress, subscriptions, playlists, settings and statistics in step between your devices, without iCloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Sync-Dienst: hält Hörstände, Abos, Playlists, Einstellungen und Statistik zwischen deinen Geräten gleich, ohne iCloud."
          }
        }
      }
    },
    "Your playlists are full (%lld entries). They share the iCloud space with your podcast progress. Remove something first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Playlists sind voll (%lld Einträge). Sie teilen sich den iCloud-Platz mit deinem Podcast-Fortschritt. Nimm zuerst etwas heraus."
          }
        }
      }
    },
    "Your Pocket Casts account" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Pocket-Casts-Konto"
          }
        }
      }
    },
    "Your saved sign-in is untouched. Downloaded titles keep playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespeicherte Anmeldung bleibt unangetastet. Geladene Titel spielen weiter."
          }
        }
      }
    },
    "Your server always comes first. Lyrics: %@ · artist images: %@ · high-res covers: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server kommt immer zuerst. Liedtexte: %@ · Künstlerbilder: %@ · hochauflösende Cover: %@."
          }
        }
      }
    },
    "Your server isn’t answering, checking again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server antwortet nicht, wird erneut geprüft."
          }
        }
      }
    },
    "Your server rejected the saved sign-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server hat die gespeicherte Anmeldung abgelehnt."
          }
        }
      }
    },
    "Your subscriptions are unaffected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Abos sind nicht betroffen."
          }
        }
      }
    },
    "Your subscriptions as OPML" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Abos als OPML"
          }
        }
      }
    }
