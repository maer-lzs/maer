    "AntennaPod" : {
      "shouldTranslate" : false
    },
    "AntennaPod's database carries subscriptions, positions, played marks and when an episode last played. An episode marked played by hand carries no moment and only fills gaps. A newer state wins; a finished episode stays finished." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AntennaPods Datenbank enthält Abos, Positionen, Gehört-Marken und wann eine Folge zuletzt lief. Eine von Hand als gehört markierte Folge trägt keinen Zeitpunkt und füllt nur Lücken. Der neuere Stand gewinnt; eine gehörte Folge bleibt gehört."
          }
        }
      }
    },
    "Anthology" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthologie"
          }
