      "comment" : "A label for the Apple podcast search source.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "Apple Podcasts" : {
      "shouldTranslate" : false
    },
    "Apple's database carries subscriptions, positions, played marks and when they were recorded. A newer state wins; a finished episode stays finished." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Datenbank enthält Abos, Positionen, Gehört-Marken und wann sie aufgezeichnet wurden. Der neuere Stand gewinnt; eine gehörte Folge bleibt gehört."
          }
        }
      }
    },
    "Applies the next time you play this station." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim nächsten Abspielen dieses Senders angewendet."
          }
        }
      }
    },
    "Applies to everything that plays: books, podcasts, music, radio. Playback starts at the default speed; Smart Rewind resumes a little earlier after a longer pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alles, was spielt: Bücher, Podcasts, Musik, Radio. Die Wiedergabe startet mit der Standardgeschwindigkeit; sanftes Zurückspulen setzt nach einer längeren Pause etwas früher wieder ein."
          }
        }
      }
    },
    "Apply" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwenden"
          }
        }
      }
