    "Mär could not read the audio of this title, so sound effects do not work on it. They apply from the next title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär konnte den Ton dieses Titels nicht lesen, darum wirkt der Klang hier nicht. Er gilt ab dem nächsten Titel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär no ha podido leer el audio de este título, así que los efectos de sonido no funcionan en él. Se aplican a partir del siguiente título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär n’a pas pu lire l’audio de ce titre, les effets sonores n’y fonctionnent donc pas. Ils s’appliquent à partir du titre suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär non è riuscita a leggere l'audio di questo titolo, quindi gli effetti sonori non funzionano. Si applicano dal titolo successivo."
          }
        }
      }
    },
    "Mär is a home for audiobooks, music, podcasts, radio and open catalogs: your own servers and the open net in one app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär ist ein Zuhause für Hörbücher, Musik, Podcasts, Radio und offene Kataloge: deine eigenen Server und das offene Netz in einer App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär es un hogar para audiolibros, música, podcasts, radio y catálogos abiertos: tus propios servidores y la red abierta en una sola app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär est un lieu pour les livres audio, la musique, les podcasts, la radio et les catalogues ouverts : vos propres serveurs et le web ouvert dans une seule app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär è una casa per audiolibri, musica, podcast, radio e cataloghi aperti: i tuoi server e la rete aperta in un'unica app."
          }
        }
      }
    },
    "Mär is an open-source player for self-hosted audio: audiobooks, podcasts, music and internet radio in one app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär ist ein quelloffener Player für selbst gehostetes Audio: Hörbücher, Podcasts, Musik und Internetradio in einer App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär es un reproductor de código abierto para audio autoalojado: audiolibros, podcasts, música y radio por internet en una sola app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär est un lecteur open source pour l’audio auto-hébergé : livres audio, podcasts, musique et radio internet dans une seule app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär è un player open source per l'audio self-hosted: audiolibri, podcast, musica e radio internet in un'unica app."
          }
        }
      }
    },
    "Mär may not reach devices on your local network. Allow it in Settings under Mär, Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär darf keine Geräte im lokalen Netzwerk erreichen. Erlaube es in den Einstellungen unter Mär, Lokales Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär no tiene permiso para acceder a dispositivos de tu red local. Permítelo en Ajustes, en Mär, Red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär n’a pas le droit de joindre les appareils de votre réseau local. Autorisez-le dans Réglages, sous Mär, Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär non può raggiungere i dispositivi sulla tua rete locale. Consentilo in Impostazioni, sotto Mär, Rete locale."
          }
        }
      }
    },
