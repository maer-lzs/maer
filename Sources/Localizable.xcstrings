    "This server does not accept this way of signing in. Nextcloud Music needs the key from its music settings as the password; Airsonic needs the password stored with a decodable encoder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server nimmt diese Art der Anmeldung nicht an. Nextcloud Music braucht als Passwort den Schlüssel aus seinen Musik-Einstellungen; Airsonic braucht ein Passwort, das mit einem dekodierbaren Verfahren gespeichert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este servidor no acepta esta forma de iniciar sesión. Nextcloud Music necesita como contraseña la clave de sus ajustes de música; Airsonic necesita la contraseña guardada con un codificador descifrable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’accepte pas ce mode de connexion. Nextcloud Music exige comme mot de passe la clé de ses réglages musique ; Airsonic exige un mot de passe stocké avec un encodeur décodable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questo server non accetta questo metodo di accesso. Nextcloud Music richiede come password la chiave delle sue impostazioni musicali; Airsonic richiede una password memorizzata con un codificatore decodificabile."
          }
        }
      }
    },
    "This server does not let Mär return from its single sign-on. Its administrator can add audiobookshelf://oauth to the allowed redirect URIs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server lässt Mär nicht aus seiner Einmalanmeldung zurückkehren. Sein Administrator kann audiobookshelf://oauth bei den erlaubten Weiterleitungsadressen eintragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este servidor no permite que Mär vuelva desde su inicio de sesión único. Su administrador puede añadir audiobookshelf://oauth a los URI de redirección permitidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne permet pas à Mär de revenir de son authentification unique. Son administrateur peut ajouter audiobookshelf://oauth aux URI de redirection autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questo server non consente a Mär di tornare dal suo single sign-on. Il suo amministratore può aggiungere audiobookshelf://oauth agli URI di reindirizzamento consentiti."
          }
        }
      }
    },
    "This server has no podcast library." : {
      "localizations" : {
