    "If switched on, Pinchflat shows will be displayed with your other subscriptions and count alongside them. Their own row will no longer be shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eingeschaltet, erscheinen Pinchflat-Sendungen bei deinen anderen Abos und zählen mit ihnen. Ihre eigene Reihe wird nicht mehr angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si se activa, los programas de Pinchflat se mostrarán con tus otras suscripciones y contarán junto a ellas. Su propia fila ya no se mostrará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’option est activée, les émissions Pinchflat s’affichent avec vos autres abonnements et sont comptées avec eux. Leur propre rangée n’est plus affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se attivato, i programmi di Pinchflat verranno mostrati con le altre iscrizioni e contati insieme a esse. La loro riga separata non verrà più mostrata."
          }
        }
      }
    },
