    },
    "%@ is indexed once on Wi-Fi. Only the directory, not the recordings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird einmal über WLAN indiziert. Nur das Verzeichnis, nicht die Aufnahmen."
          }
        }
      }
    },
    "%@ is not answering right now; showing only what %@ has." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ antwortet gerade nicht; gezeigt wird nur, was %@ hat."
          }
        }
      }
    },
    "%@ is not on Wi-Fi. Indexing it now uses about %lld MB of cellular data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht im WLAN. Jetzt zu indizieren verbraucht etwa %2$lld MB Mobilfunk-Daten."
