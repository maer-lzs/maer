    },
    "The free feed could not be followed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem freien Feed konnte nicht gefolgt werden"
          }
        }
      }
    },
    "The free-music rows then load nothing new; anything you started stays and keeps playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freie-Musik-Reihen laden dann nichts Neues; Begonnenes bleibt und lässt sich weiterhören."
          }
        }
      }
    },
    "The full history could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Historie konnte nicht geladen werden."
          }
        }
      }
    },
    "The gpodder server rejected the login (HTTP %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gpodder-Server hat die Anmeldung abgelehnt (HTTP %lld)."
          }
        }
      }
    },
    "The Gutenberg rows then load nothing new; anything you started stays and keeps playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gutenberg-Reihen laden dann nichts Neues; Begonnenes bleibt und lässt sich weiterhören."
          }
        }
      }
    },
    "The import stopped at show %lld of %lld while Mär was in the background. What it took over is kept. Start the import again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Import hielt bei Sendung %1$lld von %2$lld an, während Mär im Hintergrund war. Was er übernommen hat, bleibt. Starte den Import erneut, um fortzufahren."
          }
        }
      }
    },
    "The interface is unofficial and may stop working." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schnittstelle ist inoffiziell und kann brechen."
          }
        }
      }
    },
    "The Jamendo row could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jamendo-Reihe konnte nicht geladen werden."
          }
        }
      }
    },
    "The Jellyfin server answered with HTTP %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Jellyfin-Server antwortete mit HTTP %lld."
          }
        }
      }
    },
    "The Jellyfin server could not be reached." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Jellyfin-Server ist nicht erreichbar."
          }
        }
      }
    },
    "The Jellyfin server is not reachable from this network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Jellyfin-Server ist aus diesem Netz nicht erreichbar."
          }
        }
      }
    },
    "The kept measurements could not be read and were set aside. New ones come about once a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesammelten Messwerte waren nicht lesbar und liegen beiseite. Neue kommen etwa einmal am Tag."
          }
        }
      }
    },
    "The last thing you played, one tap away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das zuletzt Gehörte, einen Tipp entfernt."
          }
        }
      }
    },
    "The library could not be reached. Check the server and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek war nicht erreichbar. Prüfe den Server und versuch es erneut."
          }
        }
      }
    },
    "The LibriVox rows then load nothing new; anything you started stays and keeps playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die LibriVox-Reihen laden dann nichts Neues; Begonnenes bleibt und lässt sich weiterhören."
          }
        }
      }
    },
    "The listening statistics cannot be read, so the listening time of this session is not saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hörstatistik ist nicht lesbar, deshalb wird die Hörzeit dieser Sitzung nicht gespeichert."
          }
        }
      }
    },
    "The new key is held. Syncing goes on at the next occasion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neue Schlüssel wird gehalten. Der Abgleich läuft beim nächsten Anlass weiter."
          }
        }
      }
    },
    "The new link could not be followed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem neuen Link konnte nicht gefolgt werden"
          }
        }
      }
    },
    "The new password must differ from the current one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Passwort muss sich vom aktuellen unterscheiden."
          }
        }
      }
    },
    "The new password needs %lld more characters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem neuen Passwort fehlen noch %lld Zeichen."
          }
        }
      }
    },
    "The old key stays. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Schlüssel bleibt. Nichts wurde gesendet."
          }
        }
      }
    },
    "The password was changed on another device, so this device's token no longer counts. Sign in with the new password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort wurde auf einem anderen Gerät geändert, darum gilt das Zeichen dieses Geräts nicht mehr. Melde dich mit dem neuen Passwort an."
          }
        }
      }
    },
    "The podcast search then finds your own subscriptions. New feeds can still be added by hand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Podcast-Suche findet dann deine eigenen Abos. Neue Feeds kannst du weiterhin von Hand hinzufügen."
          }
        }
      }
    },
    "The server access can be read once this device is unlocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Serverzugang ist lesbar, sobald dieses Gerät entsperrt ist."
          }
        }
      }
    },
    "The server answered, but not with a channel list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat geantwortet, aber nicht mit einer Kanalliste."
          }
        }
      }
    },
    "The server does not accept this key. Enter the key from the server's music settings as the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nimmt diesen Schlüssel nicht an. Gib als Passwort den Schlüssel aus den Musik-Einstellungen des Servers ein."
          }
        }
      }
    },
    "The server has refused this feed %lld times in a row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server lehnt diesen Feed seit %lld Versuchen ab."
          }
        }
      }
    },
    "The server has refused this paid feed %lld times in a row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server lehnt diesen Bezahl-Feed seit %lld Versuchen ab."
          }
        }
      }
    },
    "The server is missing a required part of the request, such as the sign-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Server fehlt ein nötiger Teil der Anfrage, etwa die Anmeldung."
          }
        }
      }
    },
    "The server is not reachable from this network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server ist aus diesem Netz nicht erreichbar."
          }
        }
      }
    },
    "The server refused the request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anfrage abgelehnt."
          }
        }
      }
    },
    "The server rejected the API token. Please check the token or create a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den API-Token abgelehnt. Bitte Token prüfen bzw. einen neuen erzeugen."
          }
        }
      }
    },
    "The server rejected the token (401). Please check the token." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server hat den Token abgelehnt (401). Bitte Token prüfen."
          }
        }
      }
    },
    "The server rejected the token or login (401)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Token oder Login abgelehnt (401)."
          }
        }
      }
    },
    "The server responded with HTTP %lld." : {
      "comment" : "A description of an error that might occur when interacting with the gpodder server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server antwortete mit HTTP %lld."
          }
        }
      }
    },
    "The server response could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Server-Antwort ließ sich nicht lesen."
          }
        }
      }
    },
    "The service asked for sign-in settings this Mär does not accept. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst verlangt Anmelde-Einstellungen, die diese Mär nicht annimmt. Nichts wurde gesendet."
          }
        }
      }
    },
    "The service at this address offers a different key than the one this device holds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst unter dieser Adresse bietet einen anderen Schlüssel an als den, den dieses Gerät hält."
          }
        }
      }
    },
    "The service did not answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat nicht geantwortet."
          }
        }
      }
    },
    "The service does not offer a key, so it is older than this Mär. Update the service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst bietet keinen Schlüssel an, er ist also älter als diese Mär. Aktualisiere den Dienst."
          }
        }
      }
    },
    "The service has no key yet. Its operator starts it once so it makes one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat noch keinen Schlüssel. Wer ihn betreibt, startet ihn einmal, damit er einen erzeugt."
          }
        }
      }
    },
    "The service is newer than this Mär. Update the app, then sign in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst ist neuer als diese Mär. Aktualisiere die App und melde dich dann an."
          }
        }
      }
    },
    "The service is not reachable from this network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst ist aus diesem Netz nicht erreichbar."
          }
        }
      }
    },
    "The service is older than this app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst ist älter als diese App"
          }
        }
      }
    },
    "The service refused a write on %@: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat am %1$@ einen Schrieb abgewiesen: %2$@"
          }
        }
      }
    },
    "The service refused the sign-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat die Anmeldung abgelehnt."
          }
        }
      }
    },
    "The service refused this device's token, so nothing travels. Sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat das Zeichen dieses Geräts abgelehnt, also reist nichts. Melde dich neu an."
          }
        }
      }
    },
    "The service shows a new key, so nothing travels until you decide below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst zeigt einen neuen Schlüssel, deshalb reist nichts, bis du unten entscheidest."
          }
        }
      }
    },
    "The service's key has changed. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel des Dienstes hat sich geändert. Nichts wurde gesendet."
          }
        }
      }
    },
    "The shelf has titles, this combination has none." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fach hat Titel, diese Kombination nicht."
          }
        }
      }
    },
    "The show leaves your subscriptions. Listening states stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sendung verlässt deine Abos. Hörstände bleiben auf diesem Gerät."
          }
        }
      }
    },
    "The source answered without any audio track for this item." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle hat für diesen Eintrag keine Tonspur genannt."
          }
        }
      }
    },
    "The source did not answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle hat nicht geantwortet."
          }
        }
      }
    },
    "The source has withdrawn this item. Your listening mark stays until you remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle hat diesen Titel zurückgezogen. Deine Hörmarke bleibt, bis du sie entfernst."
          }
        }
      }
    },
    "The source is busy. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle ist gerade ausgelastet. Bitte später erneut versuchen."
          }
        }
      }
    },
    "The statistics of this account cannot be read on this device, so this device's listening time is not shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Statistik dieses Kontos ist auf diesem Gerät nicht lesbar, deshalb fehlt die Hörzeit dieses Geräts."
          }
        }
      }
    },
    "The subscription guard blocked an implausible mass removal. This warning stays until the next clean sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abo-Schutz hat eine unplausible Massenlöschung blockiert. Diese Warnung bleibt bis zum nächsten sauberen Sync."
          }
        }
      }
    },
    "The sync service is older than this app, so nothing travels. It works again once the service is updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sync-Dienst ist älter als diese App, deshalb reist nichts. Es geht wieder, sobald der Dienst aktualisiert ist."
          }
        }
      }
    },
    "The two new passwords differ." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beiden neuen Passwörter unterscheiden sich."
          }
        }
      }
    },
    "There is a free feed of this show: %@. Switch? Your listening positions go with it, and the paid link stays remembered for later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt den freien Feed dieser Sendung: %@. Umschalten? Die Hörstände gehen mit, der Bezahl-Link bleibt für später gemerkt."
          }
        }
      }
    },
    "There is a free feed of this show. Switch? Your listening positions go with it, and the paid link stays remembered for later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt den freien Feed dieser Sendung. Umschalten? Die Hörstände gehen mit, der Bezahl-Link bleibt für später gemerkt."
          }
        }
      }
    },
    "These are the sources that feed this type. An account exists once; the same entry appears under every type it serves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Quellen, die diesen Typ speisen. Ein Konto gibt es einmal; derselbe Eintrag erscheint unter jedem Typ, den es bedient."
          }
        }
      }
    },
    "These deliver something listenable. What you started stays yours: a source off affects new requests only, never your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie liefern Hörbares. Was du begonnen hast, bleibt deins: eine abgeschaltete Quelle betrifft nur neue Abfragen, nie deine Bibliothek."
          }
        }
      }
    },
    "These entries can only go into a Mär playlist: %@ cannot reference a catalog or local address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einträge passen nur in eine Mär-Playlist: %@ kann keine Katalog- oder lokale Adresse aufnehmen."
          }
        }
      }
    },
    "These entries can only go into a Mär playlist: your music server cannot reference a catalog or local address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einträge passen nur in eine Mär-Playlist: Dein Musikserver kann keine Katalog- oder lokale Adresse aufnehmen."
          }
        }
      }
    },
    "These entries only fit into a Mär playlist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einträge passen nur in eine Mär-Playlist."
          }
        }
      }
    },
    "These read what their surface currently shows; a copy here would measure something else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lesen, was ihre Fläche gerade zeigt; eine Kopie hier würde etwas anderes messen."
          }
        }
      }
    },
    "These recordings come from the Internet Archive, which does not guarantee their rights status." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahmen stammen aus dem Internet Archive. Ihre Rechtelage garantiert das Archiv nicht."
          }
        }
      }
    },
    "These shows arrived from your other device but could not be followed here yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sendungen kamen von deinem anderen Gerät, konnten hier aber noch nicht gefolgt werden."
          }
        }
      }
    },
    "These states carried no title or address in the show's listing. Pocket Casts named the episode when asked for it alone (%lld of %lld answered)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stände trugen in der Sendungsliste weder Titel noch Adresse. Pocket Casts hat die Folge auf Einzelnachfrage benannt (%lld von %lld beantwortet)."
          }
        }
      }
    },
    "These states name no episode of the subscribed shows. Nothing was written for them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stände nennen keine Folge der abonnierten Sendungen. Für sie wurde nichts geschrieben."
          }
        }
      }
    },
    "These wait under Not followed yet on the Podcasts tab, where you can try each again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie warten unter Noch nicht gefolgt im Podcast-Reiter, dort kannst du jede erneut versuchen."
          }
        }
      }
    },
    "They open in the browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie öffnen sich im Browser."
          }
        }
      }
    },
    "This account needs a new password before it can sign in. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto braucht ein neues Passwort, bevor es sich anmelden kann. Nichts wurde gesendet."
          }
        }
      }
    },
    "This address is plain http. Your sign-in and everything the app exchanges with the service travel sealed inside the session. Only the first fetch of the service's key and the reachability check are open on the wire; from then on the app holds that key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse ist unverschlüsseltes http. Die Anmeldung und alles, was die App mit dem Dienst austauscht, reist versiegelt in der Sitzung. Offen auf der Leitung sind nur der erste Abruf des Dienst-Schlüssels und die Erreichbarkeitsfrage; von da an hält die App diesen Schlüssel."
          }
        }
      }
    },
    "This book has no downloadable audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Buch hat kein ladbares Audio."
          }
        }
      }
    },
    "This cannot be added to a playlist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht in eine Playlist legen."
          }
        }
      }
    },
    "This could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte nicht geladen werden."
          }
        }
      }
    },
    "This could not be loaded. Check your connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte nicht geladen werden. Prüfe deine Verbindung."
          }
        }
      }
    },
    "This device could not prepare the new password. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät konnte das neue Passwort nicht vorbereiten. Nichts wurde gesendet."
          }
        }
      }
    },
    "This device does not allow notifications. Turn them on for Mär in the Settings app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät erlaubt keine Mitteilungen. Schalte sie für Mär in den Einstellungen ein."
          }
        }
      }
    },
    "This episode is no longer on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Folge ist nicht mehr auf dem Server."
          }
        }
      }
    },
    "This episode is not available on this device yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Folge ist auf diesem Gerät noch nicht verfügbar."
          }
        }
      }
    },
    "This file carries no listening states." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei enthält keine Hörstände."
          }
        }
      }
    },
    "This file is no longer on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist nicht mehr auf diesem Gerät."
          }
        }
      }
    },
    "This library has no folder to import into." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Bibliothek hat keinen Ordner für den Import."
          }
        }
      }
    },
    "This playlist has no tracks yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Playlist hat noch keine Titel."
          }
        }
      }
    },
    "This removes the podcast and its listening history from the server for everyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das entfernt den Podcast und seine Hörhistorie für alle vom Server."
          }
        }
      }
    },
    "This result is no longer available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Treffer ist nicht mehr verfügbar."
          }
        }
      }
    },
    "This server does not accept this way of signing in. Nextcloud Music needs the key from its music settings as the password; Airsonic needs the password stored with a decodable encoder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server nimmt diese Art der Anmeldung nicht an. Nextcloud Music braucht als Passwort den Schlüssel aus seinen Musik-Einstellungen; Airsonic braucht ein Passwort, das mit einem dekodierbaren Verfahren gespeichert ist."
          }
        }
      }
    },
    "This server has no podcast library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat keine Podcast-Bibliothek."
          }
        }
      }
    },
    "This server reports only %lld library. Mär cannot tell music from audiobooks inside one library. Turn one mode off, or separate them on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server meldet nur %lld Bibliothek. Mär kann Musik und Hörbücher innerhalb einer Bibliothek nicht auseinanderhalten. Schalte einen Modus ab oder trenne sie auf dem Server."
          }
        }
      }
    },
    "This server signs in with a key, which is only safe over an encrypted connection. Enter its https address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server verlangt die Anmeldung mit einem Schlüssel, und der ist nur über eine verschlüsselte Verbindung sicher. Gib seine https-Adresse ein."
          }
        }
      }
    },
    "This shelf could not be loaded. Check your connection." : {
      "comment" : "Error message displayed when a shelf of the Old Records shelf fails to load.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Fach konnte nicht geladen werden. Prüfe deine Verbindung."
          }
        }
      }
    },
    "This source contains" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quelle enthält"
          }
        }
      }
    },
    "This source does not record when an episode was heard; these states only fill gaps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quelle speichert nicht, wann gehört wurde; diese Stände füllen nur Lücken."
          }
        }
      }
    },
    "This source is on, but it is set to serve neither music nor audiobooks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quelle ist an, aber so eingestellt, dass sie weder Musik noch Hörbücher bedient."
          }
        }
      }
    },
    "This source is on, but none of the areas it feeds is switched on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quelle ist an, aber keiner der Bereiche, die sie beliefert, ist eingeschaltet."
          }
        }
      }
    },
    "This title has no file that can be played." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel hat keine Datei, die sich wiedergeben lässt."
          }
        }
      }
    },
    "Three of the five areas need no account at all. Servers can be attached here at any time; nothing has to be set up before listening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei der fünf Bereiche brauchen kein Konto. Server lassen sich hier jederzeit anschließen; vor dem ersten Hören muss nichts eingerichtet werden."
          }
        }
      }
    },
    "Tiles keep the logos they have" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kacheln behalten geladene Logos"
          }
        }
      }
    },
    "Tiles keep the logos they have; new stations get initials." : {
      "localizations" : {
