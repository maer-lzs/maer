    "Turn this source on first: the switch above is off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte diese Quelle zuerst ein: der Schalter darüber ist aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa primero esta fuente: el interruptor de arriba está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez d’abord cette source : l’interrupteur ci-dessus est désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prima attiva questa fonte: l'interruttore qui sopra è disattivato."
          }
        }
      }
    },
    "Turned off with it: %@. No visible row was using it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit ausgegangen: %@. Keine sichtbare Reihe hat es mehr genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivadas con ella: %@. Ninguna fila visible las usaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé en même temps : %@. Aucune rangée visible ne l’utilisait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattivato insieme: %@. Nessuna riga visibile lo usava."
          }
        }
      }
    },
    "Turns each switch above off, one by one. There is no overriding master any more; turning sources back on is per source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt jeden Schalter oben einzeln um. Einen übersteuernden Hauptschalter gibt es nicht mehr; wieder einschalten geht je Quelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactiva cada interruptor de arriba, uno a uno. Ya no hay un interruptor general que prevalezca; las fuentes se vuelven a activar una a una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive un par un chaque interrupteur ci-dessus. Il n’y a plus d’interrupteur général prioritaire ; la réactivation se fait source par source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattiva uno per uno ogni interruttore qui sopra. Non esiste più un interruttore generale prioritario; le fonti si riattivano una per una."
          }
        }
      }
    },
    "Turns YouTube channels into podcast feeds." : {
