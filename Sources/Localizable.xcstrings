    "What comes along" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was mitkommt"
          }
        }
      }
    },
    "What each server does, what it needs and what you enter in Mär, with links to its documentation and source code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jeder Server kann, was er braucht und was du in Mär einträgst, mit Links zu seiner Dokumentation und seinem Quellcode."
          }
        }
      }
    },
    "What it does" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was er kann"
          }
        }
      }
    },
    "What plays next, at a glance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was als Nächstes läuft, auf einen Blick."
          }
