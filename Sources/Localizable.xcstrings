    "Digitised 78 rpm records from the Internet Archive, separate from your own library. The recording year is the only rights information the source states." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalisierte Schellackplatten aus dem Internet Archive, getrennt von deiner eigenen Bibliothek. Das Aufnahmejahr ist die einzige Rechteangabe, die die Quelle macht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Discos de 78 r. p. m. digitalizados del Internet Archive, separados de tu propia biblioteca. El año de grabación es la única información sobre derechos que indica la fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques 78 tours numérisés de l’Internet Archive, séparés de votre propre bibliothèque. L’année d’enregistrement est la seule information sur les droits fournie par la source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dischi a 78 giri digitalizzati da Internet Archive, separati dalla tua libreria. L'anno di registrazione è l'unica informazione sui diritti indicata dalla fonte."
          }
        }
      }
    },
    "Direct stream URLs (e.g. from your AzuraCast or Icecast server) play like any catalog station." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte Stream-URLs (z. B. von deinem AzuraCast- oder Icecast-Server) spielen wie jeder Katalogsender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las URL de stream directas (p. ej., de tu servidor AzuraCast o Icecast) se reproducen como cualquier emisora del catálogo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les URL de flux directes (par ex. de votre serveur AzuraCast ou Icecast) se lisent comme n’importe quelle station du catalogue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli URL di stream diretti (ad es. dal tuo server AzuraCast o Icecast) vengono riprodotti come qualsiasi stazione del catalogo."
          }
        }
      }
    },
