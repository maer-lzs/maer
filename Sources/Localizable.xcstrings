    "Podcast charts and Apple search results then stay away. Your subscriptions are unaffected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-Charts und Apple-Suchergebnisse bleiben dann aus. Deine Abos sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las listas de éxitos de podcasts y los resultados de búsqueda de Apple dejan de aparecer. Tus suscripciones no se ven afectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les classements de podcasts et les résultats de recherche Apple n’apparaissent alors plus. Vos abonnements ne sont pas concernés."
          }
        },
        "it" : {
          "stringUnit" : {
