    "With both on, the Music tab asks both servers and plays each title from its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind beide an, fragt der Musik-Reiter beide Server und spielt jeden Titel von seinem eigenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con ambos activados, la pestaña Música consulta a los dos servidores y reproduce cada título desde el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les deux sont activés, l’onglet Musique interroge les deux serveurs et lit chaque titre depuis le sien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con entrambi attivi, il pannello Musica interroga entrambi i server e riproduce ogni titolo dal proprio."
          }
        }
      }
    },
    "With Downloads" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladen"
          }
        },
        "es" : {
