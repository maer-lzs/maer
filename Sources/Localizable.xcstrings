      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeichnisse"
          }
        }
      }
    },
    "Directories only help finding things. Apple sees search terms, genre numbers and your storefront country (plus standard request data like your IP address), never an account, never your subscriptions, never a listening profile; all queries are derived on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeichnisse helfen nur beim Finden. Apple sieht Suchbegriffe, Genre-Nummern und dein Storefront-Land (dazu übliche Anfragedaten wie deine IP-Adresse), nie ein Konto, nie deine Abos, nie ein Hörprofil; alle Abfragen entstehen auf diesem Gerät."
          }
        }
      }
    },
