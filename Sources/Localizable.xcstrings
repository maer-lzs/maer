    "iCloud" : {
      "shouldTranslate" : false
    },
    "iCloud is off because Mär Sync carries your data. To switch to iCloud, sign out of Mär Sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist aus, weil Mär Sync deine Daten trägt. Wer zu iCloud wechseln will, meldet sich bei Mär Sync ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud está desactivado porque Mär Sync lleva tus datos. Para pasarte a iCloud, cierra la sesión de Mär Sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est désactivé car Mär Sync transporte vos données. Pour passer à iCloud, déconnectez-vous de Mär Sync."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud è disattivato perché i tuoi dati passano da Mär Sync. Per passare a iCloud, esci da Mär Sync."
          }
        }
      }
    },
    "iCloud refused a write on %@. The shared space is full, so progress, playlists and statistics stopped syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat am %@ eine Schreibanfrage abgelehnt. Der geteilte Speicher ist voll, deshalb synchronisieren Fortschritt, Playlisten und Statistik nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud rechazó una escritura el %@. El espacio compartido está lleno, así que el progreso, las listas y las estadísticas han dejado de sincronizarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud a refusé une écriture le %@. L’espace partagé est plein, la progression, les playlists et les statistiques ne se synchronisent donc plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud ha rifiutato una scrittura il %@. Lo spazio condiviso è pieno, quindi progressi, playlist e statistiche non vengono più sincronizzati."
          }
        }
      }
    },
    "iCloud refused a write: the shared space is full" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat ein Schreiben abgelehnt: der gemeinsame Speicher ist voll"
