    "Estimated from your saved positions: listening again does not count twice, and episodes that left the feed are missing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzt aus deinen gespeicherten Positionen: erneutes Hören zählt nicht doppelt, und Folgen, die den Feed verlassen haben, fehlen."
          }
        }
      }
    },
    "Measured while playing, on all your devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abspielen gemessen, auf allen deinen Geräten."
