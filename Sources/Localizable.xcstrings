          }
        }
      }
    },
    "These states carried no title or address in the show's listing. Pocket Casts named the episode when asked for it alone (%lld of %lld answered)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stände trugen in der Sendungsliste weder Titel noch Adresse. Pocket Casts hat die Folge auf Einzelnachfrage benannt (%lld von %lld beantwortet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estos estados no llevaban título ni dirección en el listado del programa. Pocket Casts nombró el episodio al preguntarle solo por él (respondió a %lld de %lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces états n’avaient ni titre ni adresse dans la liste de l’émission. Pocket Casts a nommé l’épisode quand on l’a demandé seul (%lld sur %lld ont répondu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questi stati non avevano né titolo né indirizzo nell'elenco del programma. Pocket Casts ha indicato l'episodio quando gli è stato chiesto singolarmente (%lld risposte su %lld)."
          }
        }
      }
    },
    "These states name no episode of the subscribed shows. Nothing was written for them." : {
