    "For high-frequency shows, set this to Latest only or Off so they don't flood New Episodes, and turn off notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Vielsendern auf Nur neueste oder Aus stellen, damit sie Neue Folgen nicht fluten, und Benachrichtigungen abschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para programas que publican muy a menudo, ajusta esto en Solo el más reciente o Desactivado para que no inunden Episodios nuevos, y desactiva las notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les émissions très fréquentes, choisissez Dernier seulement ou Désactivé pour qu’elles n’envahissent pas Nouveaux épisodes, et désactivez les notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per i programmi molto frequenti, imposta Solo l'ultimo o No, così non invadono Nuovi episodi, e disattiva le notifiche."
          }
        }
      }
    },
