    "Three of the five areas need no account at all. Servers can be attached here at any time; nothing has to be set up before listening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei der fünf Bereiche brauchen kein Konto. Server lassen sich hier jederzeit anschließen; vor dem ersten Hören muss nichts eingerichtet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tres de las cinco áreas no necesitan ninguna cuenta. Aquí se pueden conectar servidores en cualquier momento; no hace falta configurar nada antes de escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois des cinq domaines ne nécessitent aucun compte. Des serveurs peuvent être ajoutés ici à tout moment ; rien n’est à configurer avant d’écouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
