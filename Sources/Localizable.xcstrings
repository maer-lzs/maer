    "Several rapid skips came in via the lock screen. This can easily happen from pocket contact. From %@ to %@. Did you really skip that far?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über den Sperrbildschirm kamen mehrere schnelle Sprünge hintereinander. Das passiert leicht durch Tastenkontakt in der Tasche. Von %@ auf %@. Wirklich so weit gesprungen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Llegaron varios saltos rápidos desde la pantalla de bloqueo. Esto puede pasar fácilmente por un toque en el bolsillo. De %@ a %@. ¿De verdad querías saltar tanto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs sauts rapides sont arrivés depuis l’écran verrouillé. Cela peut facilement arriver par un contact dans la poche. De %@ à %@. Vouliez-vous vraiment sauter aussi loin ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dalla schermata di blocco sono arrivati diversi salti rapidi. Può succedere facilmente per un contatto in tasca. Da %@ a %@. Volevi davvero saltare così avanti?"
          }
        }
      }
    },
