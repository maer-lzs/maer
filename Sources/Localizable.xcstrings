            "value" : "Pocket Casts a modifié son interface (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pocket Casts ha cambiato la sua interfaccia (%@)."
          }
        }
      }
    },
    "Pocket Casts is not reachable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket Casts ist nicht erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede conectar con Pocket Casts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket Casts est injoignable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pocket Casts non è raggiungibile."
          }
        }
      }
    },
    "Pocket Casts rejected the sign-in. Signed in with Apple or Google? Set a password on pocketcasts.com under “Forgot password” first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket Casts hat die Anmeldung abgelehnt. Bei Anmeldung über Apple oder Google: zuerst auf pocketcasts.com unter „Passwort vergessen“ ein Passwort setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pocket Casts ha rechazado el inicio de sesión. ¿Iniciaste sesión con Apple o Google? Primero establece una contraseña en pocketcasts.com en «Forgot password»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocket Casts a refusé la connexion. Connecté avec Apple ou Google ? Définissez d’abord un mot de passe sur pocketcasts.com sous « Forgot password »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pocket Casts ha rifiutato l'accesso. Hai effettuato l'accesso con Apple o Google? Prima imposta una password su pocketcasts.com in «Forgot password»."
          }
        }
      }
    },
    "Podcast" : {
