    "Apple" : {
      "comment" : "A label for the Apple podcast search source.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "Apple Podcasts" : {
      "shouldTranslate" : false
    },
    "Apple's database carries subscriptions, positions, played marks and when they were recorded. A newer state wins; a finished episode stays finished." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Datenbank enthält Abos, Positionen, Gehört-Marken und wann sie aufgezeichnet wurden. Der neuere Stand gewinnt; eine gehörte Folge bleibt gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La base de datos de Apple contiene suscripciones, posiciones, marcas de escuchado y cuándo se registraron. Un estado más reciente gana; un episodio terminado sigue terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données d’Apple contient les abonnements, les positions, les marques d’écoute et le moment de leur enregistrement. Un état plus récent l’emporte ; un épisode terminé reste terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il database di Apple contiene iscrizioni, posizioni, segni di ascoltato e quando sono stati registrati. Uno stato più recente prevale; un episodio finito resta finito."
          }
        }
      }
    },
    "Applies the next time you play this station." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim nächsten Abspielen dieses Senders angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se aplica la próxima vez que reproduzcas esta emisora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique la prochaine fois que vous lisez cette station."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si applica la prossima volta che riproduci questa stazione."
          }
        }
      }
    },
    "Applies to every device without a setting of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für jedes Gerät ohne eigene Einstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se aplica a todos los dispositivos sin ajuste propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à chaque appareil sans réglage propre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si applica a ogni dispositivo senza un'impostazione propria."
          }
        }
      }
    },
    "Applies to everything that plays: books, podcasts, music, radio. Playback starts at the default speed; Smart Rewind resumes a little earlier after a longer pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alles, was spielt: Bücher, Podcasts, Musik, Radio. Die Wiedergabe startet mit der Standardgeschwindigkeit; sanftes Zurückspulen setzt nach einer längeren Pause etwas früher wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se aplica a todo lo que suena: libros, podcasts, música, radio. La reproducción empieza a la velocidad predeterminada; Retroceso inteligente reanuda un poco antes tras una pausa larga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à tout ce qui est lu : livres, podcasts, musique, radio. La lecture démarre à la vitesse par défaut ; le Retour intelligent reprend un peu plus tôt après une pause plus longue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si applica a tutto ciò che viene riprodotto: libri, podcast, musica, radio. La riproduzione parte alla velocità predefinita; Riavvolgimento intelligente riprende un po' prima dopo una pausa più lunga."
          }
        }
      }
    },
