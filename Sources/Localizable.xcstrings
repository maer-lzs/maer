      }
    },
    "Token feeds carry their access in the URL. They are never shown unmasked, never synced to a gpodder server and left out of OPML exports by default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token-Feeds tragen ihren Zugang in der URL. Sie werden nie unmaskiert gezeigt, nie zu einem gpodder-Server synchronisiert und standardmäßig aus OPML-Exporten ausgelassen."
          }
        }
      }
    },
    "Token URL" : {
