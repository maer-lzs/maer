    "Directories" : {
      "comment" : "Settings group of external sources: podcast/radio directories (listings), not file folders.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeichnisse"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Directorios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuaires"
          }
        },
        "it" : {
          "stringUnit" : {
