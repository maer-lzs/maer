    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär verbindet sich mit deinen selbst gehosteten Audio-Servern, die oft nur im Heimnetz erreichbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mär connects to your self-hosted audio servers, which are often only reachable on your home network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mär se conecta a tus servidores de audio autoalojados, a los que a menudo solo se puede acceder desde tu red doméstica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
