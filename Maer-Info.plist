<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: the app uses only standard HTTPS/TLS (exempt
	     encryption), so no yearly self-classification is needed. This lets
	     TestFlight/App Store skip the export-compliance question per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Z1 app keys: values come from Config/AppKeys.local.xcconfig (gitignored,
	     never in the repo); empty means "not injected" and the app falls back
	     to the user-entered keys. These authenticate the APP against Jamendo/
	     PodcastIndex and carry no user identity. -->
	<key>JamendoClientId</key>
	<string>$(MAER_JAMENDO_CLIENT_ID)</string>
	<key>PodcastIndexKey</key>
	<string>$(MAER_PODCASTINDEX_KEY)</string>
	<key>PodcastIndexSecret</key>
	<string>$(MAER_PODCASTINDEX_SECRET)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>fm.maer.app.podcastRefresh</string>
	</array>
	<!-- How the system SPEAKS the name. An English voice reads "Mär" as
	     "mar"; this is the case the key exists for. The German voice says it
	     right anyway, the entry is there for completeness. -->
	<key>CFBundleSpokenName</key>
	<string>Mär</string>
	<!-- Spoken alternatives of the app's name for Siri: the bare name is
	     heard as the German word for "more", so people say "Maer App" or
	     "Mär App", and the ASCII spelling is what a keyboard produces.
	     Every alternative carries its PRONUNCIATION hint, and that is the
	     half that was missing: a spelling is of no interest to a spoken
	     command. The hint is a transcription in the SPEAKER's language
	     (Apple's own example writes "you nee corn pay" for "Unicorn Pay"),
	     so unlike the names themselves it is translated. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Maer App</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>mehr App</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Mär App</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>mehr App</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Maer</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>mehr</string>
		</dict>
	</array>
	<!-- Radio streams are frequently plain HTTP (Radio Browser url_resolved,
	     AzuraCast mounts on :8000). NSAllowsArbitraryMediaLoads relaxes ATS for
	     AVFoundation MEDIA loads only. Every URLSession call (ABS/Subsonic/
	     gpodder/Radio Browser API, metadata) still requires HTTPS. Without this
	     the AVPlayer item silently fails to load and no station plays. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The key Apple documents and Xcode's key catalog knows. A
		     misspelt key here is silently ignored, and the exception it
		     was meant to grant never existed. -->
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<!-- Self-hosted servers usually live on private IPs or .local, so iOS asks for
	     local-network permission; localized in InfoPlist.xcstrings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mär connects to your self-hosted audio servers, which are often only reachable on your home network.</string>
	<!-- Deep Link des Home-Screen-Widgets (maer://resume → Weiterhören). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fm.maer.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>maer</string>
			</array>
		</dict>
	</array>
	<!-- CarPlay-Szene MUSS hier (nicht nur im Code) deklariert sein: bei
	     SwiftUI-Lifecycle ersetzt SwiftUI den Delegate einer im Code gebauten
	     Konfiguration durch seinen eigenen, der die CarPlay-Methoden nicht
	     implementiert (Crash beim Verbinden). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
