// Base configuration of the Maer app target.
#include "AppKeys.xcconfig"

// Bundle hygiene now comes from the STRUCTURE, not from a pattern list: the
// app target's synchronised group carries `path = Sources`, so the repo root
// (docs, screenshots, test fixtures, tooling config — and the project file
// itself) is outside the swept area. What the app genuinely needs from the
// root is referenced explicitly (Assets.xcassets, LICENSE).
//
// The former EXCLUDED_SOURCE_FILE_NAMES list was the symptom treatment for
// the root sweep; with the source removed it would only be dead weight that
// hides a regression. `ArchiveMusicContractTests`/`ProjectFileIntegrityTests`
// guard the structure instead.
